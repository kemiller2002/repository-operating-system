{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://echelonfoundry.com/praxis/envelope/v1.schema.json",
  "title":"Praxis fallback reconciliation envelope",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","transactionId","workItem","branch","baseCommit","agent","timeline","requests"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "transactionId":{"type":"string","minLength":1},
    "workItem":{"type":"string","minLength":1},
    "branch":{"type":"string","minLength":1},
    "baseCommit":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "agent":{"type":"object","additionalProperties":true,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1},"provider":{"type":["string","null"]},"model":{"type":["string","null"]},"runtime":{"type":["string","null"]}}},
    "timeline":{"type":"array","items":{"type":"object","additionalProperties":true,"required":["sequence","timestamp","action"],"properties":{"sequence":{"type":"integer","minimum":1},"timestamp":{"type":"string","format":"date-time"},"action":{"type":"string","minLength":1}}}},
    "requests":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":true,"required":["type"],"properties":{"type":{"type":"string","minLength":1}}}},
    "evidence":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "artifacts":{"type":"array","items":{"type":"object","additionalProperties":true}}
  }
}